{
  "openapi": "3.1.0",
  "info": {
    "title": "English Stock",
    "description": "English Stock（英単語・英語フレーズの単語帳アプリ）に単語・フレーズを追加するための API。追加だけができ、削除・編集はできない。",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "https://icwhfknhcvaeafvmylok.supabase.co/functions/v1/chatgpt" }
  ],
  "paths": {
    "/folders": {
      "get": {
        "operationId": "listFolders",
        "summary": "追加先に選べるフォルダの一覧を取得する",
        "description": "単語・フレーズを追加する前に、どのフォルダに入れるかを確認するために使う。locked が true のフォルダには追加できない。",
        "responses": {
          "200": {
            "description": "フォルダの一覧",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "folders": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string", "description": "フォルダ名（例：しゅん）" },
                          "locked": { "type": "boolean", "description": "true なら鍵付きで、追加できない" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "連携キーが正しくない、または無効" }
        }
      }
    },
    "/stocks": {
      "post": {
        "operationId": "addStocks",
        "summary": "単語・フレーズを追加する（1回50件まで）",
        "description": "指定したフォルダに単語・フレーズを追加する。そのフォルダにすでに同じ英語がある場合は追加せず skipped に入る。削除・編集はできない。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["items"],
                "properties": {
                  "folder": {
                    "type": "string",
                    "description": "追加先のフォルダ名（listFolders の name）。フォルダが1つだけなら省略できる"
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": {
                      "type": "object",
                      "required": ["english", "japanese"],
                      "properties": {
                        "english": { "type": "string", "description": "英単語または英語フレーズ" },
                        "japanese": { "type": "string", "description": "自然な日本語訳" },
                        "category": {
                          "type": "string",
                          "enum": ["word", "phrase"],
                          "description": "word=単語, phrase=フレーズ。省略するとスペースの有無で自動判定"
                        },
                        "part_of_speech": {
                          "type": "string",
                          "enum": ["名詞", "代名詞", "動詞", "形容詞", "副詞", "助動詞", "前置詞", "冠詞", "接続詞", "間投詞"],
                          "description": "品詞（単語のときだけ・任意）"
                        },
                        "note": { "type": "string", "description": "コメント（任意・500文字まで）。例文は入れない" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "追加の結果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "folder": { "type": "string" },
                    "added": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "english": { "type": "string" },
                          "japanese": { "type": "string" },
                          "category": { "type": "string" }
                        }
                      }
                    },
                    "skipped": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "english": { "type": "string" },
                          "reason": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "フォルダの指定や内容に問題がある（error に理由）" },
          "401": { "description": "連携キーが正しくない、または無効" }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    }
  },
  "security": [{ "bearerAuth": [] }]
}
